import torch
import logging
import gc
# swtich of moviepy logger messages to the console:
# Set up logging configuration
logging.basicConfig(level=logging.WARNING)  # Set the default logging level to WARNING

# Suppress MoviePy's INFO level messages
moviepy_logger = logging.getLogger("moviepy")
moviepy_logger.setLevel(logging.WARNING)

# Optionally, remove all handlers associated with the moviepy logger
for handler in moviepy_logger.handlers:
    moviepy_logger.removeHandler(handler)

# When detections ran on fewer frames than the video has (eg 12 detection fps on a 24 fps video), still draw the annotated
# video at the full video frame rate: boxes / dots for the frames in between are placed half way between the detections
# either side (picture only - the database and statistics are untouched). False = output at the detection fps instead.
INTERPOLATE_TO_VIDEO_FPS = True


class CreateVideoAnnotated:

    # How far below the lowest calibrated pitch point (the near touchline) the black bottom panel starts, in
    # pixels of the calibration image. Bigger = more margin under the pitch, smaller panel / overhead.
    PANEL_CLEARANCE_PX = 40

    ######################## - INIT
    def __init__(self, 
                 DURATION, 
                 BATCH_DURATION, 
                 DATABASE_FILE, 
                 OBJECT_IMAGES_FOLDER, 
                 OUTPUT_PATH, 
                 TEAMS, 
                 GAME_RECORD,
                 PITCH_DETECTION_OVERRIDE,
                 GAME_PITCH_KEYPOINTS_WITH_NAMES,
                 GAME_PITCH_BOUNDARIES,
                 ANNOTATED_PATH=None,
                 WORK_DIR=None):

        print("-------------------------------------------------")
        print("CREATE VIDEO ANNOTATED: Creating video from database records")

        

        self.INPUT_VIDEO_TITLE = GAME_RECORD['statistics_source_video']
        self.START_TIME = TimeUtils.time_to_seconds(GAME_RECORD['game_start_seconds'])
        self.END_TIME = TimeUtils.time_to_seconds(GAME_RECORD['game_end_seconds'])
        self.DURATION = DURATION
        self.BATCH_DURATION = BATCH_DURATION
        
        self.DATABASE_FILE = DATABASE_FILE
        self.OBJECT_IMAGES_FOLDER = OBJECT_IMAGES_FOLDER
        self.OUTPUT_VIDEO_TITLE = StringUtils.replace_spaces_with_underscores(GAME_RECORD['title'])
        self.CREATE_VIDEO_OUTPUT_PATH = OUTPUT_PATH
        self.ANNOTATED_PATH = ANNOTATED_PATH or OUTPUT_PATH      # finished annotated videos go here
        self.WORK_DIR = WORK_DIR or OUTPUT_PATH                  # throw-away files (chunks, the video without sound) go here
        self.TEAMS = TEAMS
        self.GAME_RECORD = GAME_RECORD
        self.GAME_RUNNING_SPEED = float(GAME_RECORD['running_speed_km_h'])

        #- Per-game pitch size for the top-view inset (drives transform_point_to_new_rectangle).
        #  Preferred: from this game's Pitch Calibrator export (pitch_calibrator_json), which
        #  is also what fitted_pitch_transformer.py fits the detections against, so the inset
        #  stays consistent with the database's x/y_transformed_metres. Falls back to the old
        #  hardcoded 46x21 for any game without a calibrator JSON yet.
        self.PANEL_TOP_FRACTION = None   # None = legacy fixed bottom panel (no calibration available)
        self.PITCH_OUTLINE_FRAC = None
        self.TOP_MASK_FRAC = None
        calibrator_json = GAME_RECORD.get('pitch_calibrator_json') if hasattr(GAME_RECORD, 'get') else None
        if isinstance(calibrator_json, str) and calibrator_json.strip():
            pitch_dims = json.loads(calibrator_json)['pitch_dimensions_m']
            self.PITCH_LENGTH_M = float(pitch_dims['length'])
            self.PITCH_WIDTH_M = float(pitch_dims['width'])
            # accuracy-test overlay: ideal circles/arcs + where the clicked circle points land
            from view_transformer.fitted_pitch_transformer import FittedPitchTransformer
            _fitted = FittedPitchTransformer(json.loads(calibrator_json), verbose=False)
            self.PITCH_OVERLAY = _fitted.overlay_geometry()
            self.FOOT_PIXEL_FN = _fitted.foot_pixel if _fitted.has_vertical_vp else None

            # Bottom black panel starts just BELOW the lowest calibrated pitch point (the near touchline),
            # so the whole pitch stays visible above it. Fraction of frame height; the calibration was done
            # on image_size, so this also holds if the annotated video has a different resolution.
            calibration = json.loads(calibrator_json)
            lowest_y = []
            def _collect_y(node):
                if isinstance(node, dict):
                    if 'x' in node and isinstance(node.get('y'), (int, float)):
                        lowest_y.append(float(node['y']))
                    for child in node.values():
                        _collect_y(child)
                elif isinstance(node, list):
                    for child in node:
                        _collect_y(child)
            _collect_y(calibration.get('pitch_vertices'))
            _collect_y(calibration.get('circle_points'))
            image_height = float((calibration.get('image_size') or {}).get('h') or (calibration.get('image_size') or {}).get('height') or 1080)
            if lowest_y:
                self.PANEL_TOP_FRACTION = (max(lowest_y) + self.PANEL_CLEARANCE_PX) / image_height

            # pitch boundary in the frame (as fractions) so the overhead can grow without covering the pitch
            outline = _fitted.pitch_outline_pixels()
            self.PITCH_OUTLINE_FRAC = [(float(x) / _fitted.img_w, float(y) / _fitted.img_h) for x, y in outline]
            # netting edge clicked in the Pitch Calibrator (optional): everything above it is blacked out
            self.TOP_MASK_FRAC = [(float(p['x']) / _fitted.img_w, float(p['y']) / _fitted.img_h)
                                  for p in (calibration.get('top_mask_points') or []) if p and p.get('x') is not None]
        else:
            self.PITCH_LENGTH_M = 46.0
            self.PITCH_WIDTH_M = 21.0
            self.PITCH_OVERLAY = None
            self.FOOT_PIXEL_FN = None

        self.PITCH_DETECTION_OVERRIDE = PITCH_DETECTION_OVERRIDE
        self.PITCH_OVERRIDE_KEYPOINTS = GAME_PITCH_KEYPOINTS_WITH_NAMES
        self.PITCH_OVERRIDE_BOUNDARIES = GAME_PITCH_BOUNDARIES

        # get the games details from the database:
        self.conn = sqlite3.connect(self.DATABASE_FILE)
        self.cursor = self.conn.cursor()
        self.cursor.execute('''
                    SELECT _id, game_id, video, video_fps, detection_fps
                    FROM game
                    WHERE game_id = ?
                ''', (self.GAME_RECORD['game_id'],))
        self.DB_GAME_DETAILS = self.cursor.fetchone()
        self.DETECTION_FPS = self.DB_GAME_DETAILS[4]
        self.ORIGINAL_VIDEO_FPS = self.DB_GAME_DETAILS[3]
        self.CREATE_VIDEO_OUTPUT_FPS = self.DETECTION_FPS

        # frames in between the detection frames get interpolated detections, so the video is drawn at the video fps
        self.INTERPOLATE = bool(INTERPOLATE_TO_VIDEO_FPS and self.DETECTION_FPS < self.ORIGINAL_VIDEO_FPS)
        self.OUTPUT_FPS = self.ORIGINAL_VIDEO_FPS if self.INTERPOLATE else self.DETECTION_FPS

        # Calculate start and end frames to process
        start_frame = int(self.START_TIME * self.ORIGINAL_VIDEO_FPS)
        end_frame = int(self.END_TIME * self.ORIGINAL_VIDEO_FPS)
        '''
        # end time is either the duration or if a duration of 0 is sent we choose the whole video !
        if self.DURATION > 0:
            end_frame = start_frame + int(self.DURATION * self.ORIGINAL_VIDEO_FPS)
            print(f"🔄 Processing SPECIFIC DURATION to frame {end_frame} based on DURATION={self.DURATION} seconds")
        else:
            end_frame = int(self.END_TIME * self.ORIGINAL_VIDEO_FPS)
            print(f"📊 Processing FULL VIDEO frames from {start_frame} to {end_frame}")
        '''

        # Determine the device and configure runtime settings:
        if torch.cuda.is_available():
            self.DEVICE = "cuda"
            self.CHUNK_SIZE = self.DETECTION_FPS*30  # Optional: adjust chunk size based on your memory constraints fps
            self.ANNOTATIONS_BATCH_SIZE = self.DETECTION_FPS*30  # Adjust based on your GPU memory
            os.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'expandable_segments:True'

        elif torch.backends.mps.is_available():
            self.DEVICE = "mps"  # m1 has a problem running :  Output channels > 65536 not supported at the MPS device
            self.CHUNK_SIZE = self.DETECTION_FPS*10  # Optional: adjust chunk size based on your memory constraints fps
            self.ANNOTATIONS_BATCH_SIZE = self.DETECTION_FPS*10  # Adjust based on your GPU memory
        else:
            self.DEVICE = "cpu"
            self.CHUNK_SIZE = self.DETECTION_FPS*30  # Optional: adjust chunk size based on your memory constraints fps
            self.ANNOTATIONS_BATCH_SIZE = self.DETECTION_FPS*30  # Adjust based on your CPU memory
    

        # Get valid frame_ids in that range from the database:
        self.cursor.execute('''
            SELECT DISTINCT frame_id 
            FROM detected_objects
            WHERE frame_id BETWEEN ? AND ?
            ORDER BY frame_id
        ''', (start_frame, end_frame))
            
        self.valid_frame_ids = [row[0] for row in self.cursor.fetchall()]
        if self.INTERPOLATE:
            # every frame that has detections (whole game, not only the requested range, so the edges blend properly)
            self.cursor.execute('SELECT DISTINCT frame_id FROM detected_objects')
            detection_frames = [row[0] for row in self.cursor.fetchall()]
            stride = max(1, int(round(self.ORIGINAL_VIDEO_FPS / self.DETECTION_FPS)))
            self.interpolator = FrameInterpolator(self.get_frame_details_from_db, detection_frames, max_gap=2 * stride)
            print(f"🎞️ Detections every {stride} video frames ({self.DETECTION_FPS} fps): in-between frames interpolated, video drawn at {self.OUTPUT_FPS} fps")
        # Ensure all frames are included, even if no data
        all_frame_ids = list(range(start_frame, end_frame + 1))
        self.valid_frame_ids = sorted(set(self.valid_frame_ids + all_frame_ids))
        print(f"✅ Found {len(self.valid_frame_ids)} valid frames in the database within the specified duration.")
        #print("Frame IDs in database:", self.valid_frame_ids[:100], "...")  # Print first 10 frames
        
        # Create the output video file name:
        timestr = time.strftime("%Y%m%d-%H%M%S")
        #self.OUTPUT_VIDEO_TITLE = f"../output/game-id-{self.GAME_RECORD['game_id']}-{StringUtils.replace_spaces_with_underscores(self.GAME_RECORD['title'])}-{timestr}.mp4"
        self.OUTPUT_VIDEO_TITLE = GameFiles.report_file(self.WORK_DIR, self.GAME_RECORD, "annotated-no-sound", timestr, "mp4")
        self.OUTPUT_VIDEO_TITLE_WITH_AUDIO = GameFiles.report_file(self.ANNOTATED_PATH, self.GAME_RECORD, "annotated", timestr, "mp4")

    ##########################################################
    # Get frame details from database: objects and pitch keypoints
    ##########################################################
    def get_frame_details_from_db(self,frame_number):

        # Fetch DETECTED OBJECTS for this frame:
        # show the stitched player_id (from track_stitcher) where the database has one, else the raw tracker_id
        if not hasattr(self, "_id_expression"):
            self.cursor.execute("PRAGMA table_info(detected_objects)")
            has_player_id = "player_id" in {row[1] for row in self.cursor.fetchall()}
            self._id_expression = "COALESCE(player_id, tracker_id)" if has_player_id else "tracker_id"
        self.cursor.execute(f'''
            SELECT xmin, ymin, xmax, ymax, confidence, class_id, {self._id_expression}, class_name, 
                x_transformed_metres, y_transformed_metres, speed_km_per_hour, 
                total_distance_metres, ball_posession, is_inside_pitch, team, team_color
            FROM detected_objects
            WHERE frame_id = ? AND is_inside_pitch = 1
        ''', (frame_number,))
        objects_rows = self.cursor.fetchall()
        # Convert objects to list of dictionaries
        objects = []
        for row in objects_rows:
            objects.append({
                'xmin': row[0],
                'ymin': row[1],
                'xmax': row[2],
                'ymax': row[3],
                'confidence': row[4],
                'class_id': row[5],
                'tracker_id': row[6],
                'class_name': row[7],
                'x_transformed_metres': row[8],
                'y_transformed_metres': row[9],
                'speed_km_per_hour': row[10],
                'total_distance_metres': row[11],
                'ball_posession': row[12],
                'is_inside_pitch': row[13],
                'team': row[14],
                'team_color': row[15]
            })
        
        # Fetch PITCH KEYPOINTS for this frame:
        self.cursor.execute('''
            SELECT x, y, name, x_transformed_metres, y_transformed_metres
            FROM detected_pitch
            WHERE frame_id = ?
        ''', (frame_number,))
        pitch_rows = self.cursor.fetchall()
        # Convert pitch points to list of dictionaries
        pitch_points = []
        for row in pitch_rows:
            pitch_points.append({
                'x': row[0],
                'y': row[1],
                'name': row[2],
                'x_transformed_metres': row[3],
                'y_transformed_metres': row[4]
            })

        return objects, pitch_points


    ########################################## - CONVERT ANY FRAME_ID TO MM:SS
    def frame_to_timestamp(self,frame_index):
        """
        Convert a frame index to MM:SS timestamp.
        
        Args:
            frame_index (int): The current frame index.
            fps (int): Frames per second of the video.
            
        Returns:
            str: Time in MM:SS format.
        """
        total_seconds = frame_index / self.ORIGINAL_VIDEO_FPS  # Get time in seconds
        minutes = int(total_seconds // 60)  # Get minutes
        seconds = int(total_seconds % 60)  # Remaining seconds
        return f"{minutes:02}:{seconds:02}"
    

    ##########################################################
    # Create annotated video
    ##########################################################
    def run(self):
        """
        Process video using MoviePy/FFmpeg, using specific frame IDs from database.
        Processes frames in chunks to manage memory usage.
        """
        start_time = time.time()
        
        print(f"🔄 Loading video: {self.INPUT_VIDEO_TITLE}")
        print(f"✅ Total frames to process: {len(self.valid_frame_ids)}")
        
        video = VideoFileClip(self.INPUT_VIDEO_TITLE)
        original_fps = video.fps
        print(f"✅ Original video FPS: {original_fps}")
        print(f"✅ Target output FPS: {self.OUTPUT_FPS}")
        print(f"✅ Device: {self.DEVICE} | Chunk size:{self.CHUNK_SIZE} | Annotation batch size: {self.ANNOTATIONS_BATCH_SIZE}")

        
        # Create and clean temporary directory for chunks
        temp_dir = os.path.join(self.WORK_DIR, "temp_video_chunks")
        if os.path.exists(temp_dir):
            # Remove all files in the directory
            for file in os.listdir(temp_dir):
                file_path = os.path.join(temp_dir, file)
                try:
                    if os.path.isfile(file_path):
                        os.unlink(file_path)
                        print(f"🔄 Deleted existing temp file: {file}")
                except Exception as e:
                    print(f"Error deleting {file_path}: {e}")
        # Create the directory (or ensure it exists if already empty)
        os.makedirs(temp_dir, exist_ok=True)
        
        # Process frames in chunks
        chunk_files = []
        frame_ids = sorted(self.valid_frame_ids)

        # Calculate how many frames to skip to achieve DETECTION_FPS
        frame_skip = 1 if self.INTERPOLATE else int(self.ORIGINAL_VIDEO_FPS / self.DETECTION_FPS)

        # Filter frame_ids to match DETECTION_FPS
        frame_ids = frame_ids[::frame_skip]

        # Calculate frames per chunk for 15 seconds using DETECTION_FPS
        frames_per_chunk = int(15 * self.OUTPUT_FPS)

        # Calculate total chunks based on frames_per_chunk
        total_chunks = (len(frame_ids) + frames_per_chunk - 1) // frames_per_chunk

        for chunk_idx, chunk_start in enumerate(range(0, len(frame_ids), frames_per_chunk), 1):
            
            chunk_start_time = time.time()
            chunk_end = min(chunk_start + frames_per_chunk, len(frame_ids))
            current_chunk = frame_ids[chunk_start:chunk_end]

            print(f"🔄 -- Processing chunk {chunk_idx} of {total_chunks}: frames {self.frame_to_timestamp(current_chunk[0])} to {self.frame_to_timestamp(current_chunk[-1])}: ------------------------------")
            
            # Process chunk
            clips = []
            
            # Initialize batch containers
            batch_frames = []
            batch_frame_ids = []
            batch_objects = []
            batch_pitches = []
            
            # Process frames within chunk
            for frame_id in current_chunk:
                t = frame_id / original_fps
                frame = video.get_frame(t).copy()
                
                # Convert frame from RGB to BGR for OpenCV compatibility
                frame = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)
                
                # Get DB data
                if self.INTERPOLATE:
                    db_objects, db_pitch = self.interpolator.get(frame_id)
                else:
                    db_objects, db_pitch = self.get_frame_details_from_db(frame_id)

                # Add to batch
                batch_frames.append(frame)
                batch_frame_ids.append(frame_id)
                batch_objects.append(db_objects if db_objects else [])
                batch_pitches.append(db_pitch if db_pitch else [])

                # Process batch when full or at end of chunk
                if len(batch_frames) >= self.ANNOTATIONS_BATCH_SIZE or frame_id == current_chunk[-1]:
                    # Check if any frames in the batch have objects
                    has_objects = any(len(objs) > 0 for objs in batch_objects)
                    
                    if has_objects:
                        # Draw annotations directly on the frame
                        annotated_frames = draw_annotations.draw_annotations_batch(
                                batch_frame_ids,
                                batch_frames,
                                batch_objects,
                                batch_pitches,
                                self.TEAMS,
                                self.PITCH_DETECTION_OVERRIDE,
                                self.DETECTION_FPS,
                                self.ORIGINAL_VIDEO_FPS,
                                self.GAME_RUNNING_SPEED,
                                self.PITCH_LENGTH_M,
                                self.PITCH_WIDTH_M,
                                self.PITCH_OVERLAY,
                                self.FOOT_PIXEL_FN,
                                self.PANEL_TOP_FRACTION,
                                self.PITCH_OUTLINE_FRAC,
                                self.TOP_MASK_FRAC
                        )
                        
                        # Convert annotated frames back to RGB for MoviePy
                        annotated_frames = [cv2.cvtColor(frame, cv2.COLOR_BGR2RGB) 
                                          for frame in annotated_frames]
                    
                        # Add annotated frames to clips
                        for annotated_frame in annotated_frames:
                            clips.append(VideoClip(lambda t, f=annotated_frame: f, duration=1.0/self.OUTPUT_FPS))
                    else:
                        # add empty frames as no objects found in the db
                        print(f"🔄 -- Adding empty frames as no objects found in the db")
                        for frame in batch_frames:
                            frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
                            clips.append(VideoClip(lambda t, f=frame_rgb: f, duration=1.0/self.OUTPUT_FPS))
                    
                    # Clear batches after processing
                    batch_frames.clear()
                    batch_frame_ids.clear()
                    batch_objects.clear()
                    batch_pitches.clear()

                    # Trigger garbage collection after clearing large lists
                    gc.collect()
            
            # Save chunk to temporary file
            chunk_path = os.path.join(temp_dir, f"chunk_{chunk_start:06d}.mp4")
            chunk_files.append(chunk_path)
            
            # Use a context manager for writing video files
            with moviepy.editor.concatenate_videoclips(clips, method="compose") as chunk_clip:

                if torch.backends.mps.is_available():
                    chunk_clip.write_videofile(
                        chunk_path,
                        fps=self.OUTPUT_FPS,
                        codec='h264_videotoolbox',
                        audio=False,
                        threads=4,
                        preset='fast',
                        ffmpeg_params=['-crf', '18', '-b:v', '3000k']
                    )
                else:
                    chunk_clip.write_videofile(
                        chunk_path,
                        fps=self.OUTPUT_FPS,
                        audio=False,
                        threads=4,
                        preset='fast',
                        ffmpeg_params=['-crf', '18', '-b:v', '3000k']
                    )
            
            # Clear clips to free memory
            clips.clear()
            # Trigger garbage collection after clearing large lists
            gc.collect()
            
            # TIME FOR FULL PROCESS: Calculate elapsed time for the chunk and estimate the total remaining time
            chunk_end_time = time.time()
            time_taken = chunk_end_time - chunk_start_time  # Time taken for the current chunk
            # Estimate remaining time
            chunks_remaining = total_chunks - chunk_idx  # Number of chunks left
            estimated_remaining_time = time_taken * chunks_remaining  # Estimated time remaining
            estimated_remaining_minutes = estimated_remaining_time // 60  # Convert to minutes
            estimated_remaining_seconds = estimated_remaining_time % 60  # Remaining seconds

            print(f"✅ Chunk completed in {time_taken:.2f} sec: Time remaining est: {int(estimated_remaining_minutes)}m {int(estimated_remaining_seconds)}s")
        
        # COMBINE VIDEO CLIPSConcatenate all chunks using ffmpeg directly
        print("\n🔄 Concatenating chunks into 1 video: --------------------------------------------------------")
        concat_list = os.path.join(self.WORK_DIR, "temp_files.txt")
        with open(concat_list, "w") as f:
            for chunk_file in chunk_files:
                f.write(f"file '{chunk_file}'\n")
        
        # Use VideoToolbox for concatenation
        os.system(f'ffmpeg -hwaccel videotoolbox -f concat -safe 0 -i "{concat_list}" -c copy "{self.OUTPUT_VIDEO_TITLE}"')
        
        # Add audio from original video to the final video and save as a new video:
        print("...Adding audio to merged video from source video...")
        audio_result = os.system(f'ffmpeg -i "{self.OUTPUT_VIDEO_TITLE}" -i "{self.INPUT_VIDEO_TITLE}" -c:v copy -map 0:v:0 -map 1:a:0 "{self.OUTPUT_VIDEO_TITLE_WITH_AUDIO}"')
        
        # If audio addition was successful (return code 0), delete the video without audio
        if audio_result == 0:
            print("Successfully added audio, removing video without audio...")
            os.remove(self.OUTPUT_VIDEO_TITLE)
        else:
            print("Warning: Audio addition failed, keeping video without audio")

        # MEMORY CLEARING: Cleanup
        '''
        print("Cleaning up temporary files...")
        video.close()
        for chunk_file in chunk_files:
            os.remove(chunk_file)
        os.remove("temp_files.txt")
        os.rmdir(temp_dir)
        '''

        # Final garbage collection before exiting
        gc.collect()
        
        # TIME FOR FULL PROCESS: Calculate elapsed time for entire process:
        end_time = time.time()
        print(f"\n✅ Video Processing completed in {end_time - start_time:.2f} seconds")
