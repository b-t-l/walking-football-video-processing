:root {
  --bg: #FCFBF9; --card: #ffffff; --text: #1d2330; --muted: #667085; --line: #e1e4ea;
  --brand: #068C37; --brand-ink: #ffffff; --brand-soft: #e4f3ea;
  --warn: #9a5b00; --warn-soft: #fff1d6; --bad: #b42318; --bad-soft: #fde7e5; --ok: #068C37; --info-soft: #e8eefb; --info: #2a4a9a;
  --radius: 8px;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #14171c; --card: #1c2027; --text: #e6e9ef; --muted: #9aa3b2; --line: #2d333d;
    --brand: #3fa56c; --brand-ink: #0c1a12; --brand-soft: #1b3326;
    --warn: #f0b955; --warn-soft: #3a2c10; --bad: #ff8a7a; --bad-soft: #3d1d1a; --ok: #6fd09a; --info-soft: #1d2a47; --info: #9db8f5;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.top-unused { display: flex; align-items: center; gap: 28px; padding: 12px 24px; background: var(--card); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
.brand { font-weight: 700; font-size: 17px; }
.brand .sub { font-weight: 400; color: var(--muted); font-size: 13px; margin-left: 8px; }
nav a { color: var(--muted); text-decoration: none; padding: 6px 12px; border-radius: 6px; margin-right: 4px; }
nav a.active { background: var(--brand-soft); color: var(--brand); font-weight: 600; }
main { max-width: 1180px; margin: 0 auto; padding: 24px; }
h1 { font-size: 22px; margin: 0 0 16px; }
h2 { font-size: 16px; margin: 0 0 12px; }
.row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.spread { justify-content: space-between; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; margin-bottom: 18px; }
.muted { color: var(--muted); }
.small { font-size: 13px; }
label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 4px; }
input, select, textarea { font: inherit; color: var(--text); background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 7px 9px; width: 100%; }
input:focus, select:focus, textarea:focus, button:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }
input[type=checkbox], input[type=radio] { width: auto; }
input[type=color] { padding: 2px; width: 44px; height: 34px; }
textarea { resize: vertical; min-height: 70px; }
textarea.code { font: 12px/1.4 ui-monospace, Menlo, monospace; min-height: 110px; }
.grid { display: grid; gap: 14px; grid-template-columns: repeat(12, 1fr); }
.c2 { grid-column: span 2; } .c3 { grid-column: span 3; } .c4 { grid-column: span 4; } .c5 { grid-column: span 5; } .c6 { grid-column: span 6; } .c12 { grid-column: span 12; }
@media (max-width: 800px) { .grid > * { grid-column: span 12; } main { padding: 14px; } }
button, .btn { font: inherit; border: 1px solid var(--line); background: var(--card); color: var(--text); border-radius: 6px; padding: 7px 14px; cursor: pointer; text-decoration: none; display: inline-block; }
button:hover, .btn:hover { border-color: var(--muted); }
button.primary, .btn.primary { background: var(--brand); color: var(--brand-ink); border-color: var(--brand); font-weight: 600; }
button.danger { color: var(--bad); }
button.link { border: none; background: none; color: var(--brand); padding: 2px 4px; }
button:disabled { opacity: .5; cursor: default; }
table { width: 100%; border-collapse: collapse; }
th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); padding: 8px 10px; border-bottom: 1px solid var(--line); }
td { padding: 9px 10px; border-bottom: 1px solid var(--line); vertical-align: middle; }
tr.click { cursor: pointer; } tr.click:hover td { background: var(--bg); }
tr.archived td { opacity: .55; }
.chip { display: inline-block; font-size: 12px; padding: 2px 9px; border-radius: 99px; margin: 1px 4px 1px 0; white-space: nowrap; }
.chip.ok { background: var(--brand-soft); color: var(--ok); }
.chip.warn { background: var(--warn-soft); color: var(--warn); }
.chip.info { background: var(--info-soft); color: var(--info); }
.chip.bad { background: var(--bad-soft); color: var(--bad); }
.notice { border-radius: 6px; padding: 10px 14px; margin-bottom: 14px; }
.notice.warn { background: var(--warn-soft); color: var(--warn); }
.notice.bad { background: var(--bad-soft); color: var(--bad); }
.notice.ok { background: var(--brand-soft); color: var(--ok); }
.notice ul { margin: 4px 0 0 18px; padding: 0; }
.vs { text-align: center; color: var(--muted); padding-top: 24px; }
.score { width: 64px; text-align: center; }
.savebar { position: sticky; bottom: 0; background: var(--card); border-top: 1px solid var(--line); padding: 12px 24px; margin: 0 -24px -24px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.swatch { display: inline-block; width: 18px; height: 18px; border-radius: 4px; border: 1px solid var(--line); vertical-align: middle; margin-right: 3px; }
.pts { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; }
.pts div { background: var(--bg); border-radius: 6px; padding: 6px 8px; font-size: 13px; }
.pts b { display: block; font-size: 11px; color: var(--muted); font-weight: 500; }
@media (max-width: 800px) { .pts { grid-template-columns: repeat(2, 1fr); } }
pre.rec { background: var(--bg); padding: 12px; border-radius: 6px; overflow: auto; font-size: 12px; max-height: 420px; }
.toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); background: #1d2330; color: #fff; padding: 10px 18px; border-radius: 8px; z-index: 1100; box-shadow: 0 4px 14px rgba(0,0,0,.25); }
.toast.bad { background: var(--bad); color: #fff; }
.filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; align-items: end; }
.filters > div { min-width: 140px; }
.filters .grow { flex: 1; min-width: 200px; }
details summary { cursor: pointer; color: var(--brand); }
.cal { display: flex; gap: 12px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.cal:last-child { border-bottom: none; }
dialog { border: 1px solid var(--line); border-radius: 10px; background: var(--card); color: var(--text); padding: 20px; width: min(620px, 94vw); }
dialog::backdrop { background: rgba(0,0,0,.4); }

dialog#picker { width: min(760px, 95vw); }
.pk-list { border: 1px solid var(--line); border-radius: 6px; max-height: 48vh; overflow: auto; }
.pk-row { display: flex; justify-content: space-between; gap: 12px; padding: 7px 12px; cursor: pointer; border-bottom: 1px solid var(--line); }
.pk-row:last-child { border-bottom: none; }
.pk-row:hover { background: var(--brand-soft); }
.pk-name { overflow-wrap: anywhere; }

/* ---- game page: video band and collapsible sections ---- */
.stage-band { background: #0d1410; color: #e8ece9; border-radius: 10px; padding: 14px; margin-bottom: 14px; display: grid; grid-template-columns: minmax(0, 1fr) 310px; gap: 18px; }
@media (max-width: 960px) { .stage-band { grid-template-columns: 1fr; } }
.stage-main { position: relative; min-width: 0; }
.stage-main video { width: 100%; max-height: 58vh; min-height: 220px; background: #000; border-radius: 6px; display: block; }
.pv-msg { position: absolute; left: 10px; right: 10px; bottom: 56px; background: rgba(13, 20, 16, .92); border: 1px solid #2d3a31; border-radius: 8px; padding: 10px 12px; font-size: 13px; }
.pv-msg.bad { border-color: #b4592a; }
.stage-side { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.stage-side label { color: #9fada3; font-size: 12px; display: block; margin-bottom: 4px; }
.stage-band select { background: #1a241d; color: #e8ece9; border-color: #2d3a31; }
.stage-band button { background: #1a241d; color: #e8ece9; border: 1px solid #2d3a31; padding: 6px 9px; font-size: 13px; }
.stage-band button:hover { border-color: #feca02; }
.stage-band button.link { background: none; border: none; color: #feca02; padding: 0; }
.pv-time { font: 600 30px/1.1 ui-monospace, Menlo, monospace; }
.pv-dur { font-size: 16px; color: #9fada3; font-weight: 400; }
.pv-skip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.pv-marks { border-top: 1px solid #2d3a31; padding-top: 10px; }
.pv-marks.off { opacity: .35; pointer-events: none; }
.pv-mh { font-size: 12px; color: #9fada3; margin-bottom: 6px; }
.mk { display: grid; grid-template-columns: 1fr auto auto; gap: 6px; align-items: center; margin-bottom: 5px; }
.mk-l { font-size: 13px; }
.mk-go { font-family: ui-monospace, Menlo, monospace; min-width: 4.6em; }
details.sec { background: var(--card); border: 1px solid var(--line); border-radius: 8px; margin-bottom: 10px; }
details.sec > summary { list-style: none; cursor: pointer; display: flex; gap: 12px; align-items: center; padding: 12px 16px; }
details.sec > summary::-webkit-details-marker { display: none; }
details.sec > summary::before { content: "\25B8"; color: var(--muted); transition: transform .15s; }
details.sec[open] > summary::before { transform: rotate(90deg); }
.sec-title { color: var(--text); font-weight: 600; min-width: 130px; }
.sec-sum { color: var(--muted); font-size: 13px; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.sec-act { flex: none; padding: 5px 12px; font-size: 13px; }
.sec-body { padding: 2px 18px 18px; border-top: 1px solid var(--line); }
.sec-tools { display: flex; gap: 14px; justify-content: flex-end; margin: 0 4px 6px; font-size: 13px; }

/* game folder box (Video files section) */
.folder-box { margin-top: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--info-soft); font-size: .92rem; }
.folder-box code { word-break: break-all; }

/* run panel + console */
.run-steps { display: grid; gap: 6px; margin-top: 12px; }
.run-step { display: flex; gap: 8px; align-items: baseline; margin: 0; color: var(--text); font-weight: 400; }
.run-annotate-bg { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; }
.run-annotate-bg label { display: inline-flex; gap: 8px; align-items: center; margin: 0; color: var(--text); font-weight: 400; }
.run-test { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; }
.run-test label { display: inline-flex; gap: 6px; align-items: center; margin: 0; color: var(--text); font-weight: 400; }
.run-bar { height: 10px; background: var(--line); border-radius: 6px; margin-top: 12px; overflow: hidden; }
.run-bar > div { height: 100%; width: 0; background: var(--brand); transition: width .4s; }
.run-line { margin-top: 6px; min-height: 1.2em; font-family: ui-monospace, Menlo, monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.console { background: #0f1512; color: #d7e3da; font: 12px/1.4 ui-monospace, Menlo, Consolas, monospace; padding: 10px 12px; border-radius: var(--radius);
  height: 380px; overflow: auto; white-space: pre-wrap; word-break: break-all; margin: 8px 0 0; }

.run-view-bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 12px; }
.run-view-title { font-size: 12px; color: var(--muted, #6b7a70); text-transform: uppercase; letter-spacing: .04em; }
.run-view.max { position: fixed; inset: 0; z-index: 1000; background: var(--bg); padding: 14px 18px; display: flex; flex-direction: column; margin: 0; }
.run-view.max .run-view-bar { margin-top: 0; }
.run-view.max .console { flex: 1 1 auto; height: auto; min-height: 0; font-size: 13px; }
body.run-max-open { overflow: hidden; }

.run-reports { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); }
.rep-row { display: flex; gap: 10px; align-items: baseline; padding: 3px 0; }
.rep-row a { font-weight: 600; color: var(--brand); }

/* ---- identity / name players (video uses almost the full window) ---- */
main:has(.id-layout) { max-width: none; padding: 6px 10px 8px; }
.id-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) clamp(360px, 29vw, 480px);
  gap: 10px;
  align-items: stretch;
  height: calc(100vh - 68px);
  min-height: 420px;
}
@media (max-width: 960px) {
  .id-layout { grid-template-columns: 1fr; height: auto; }
  .id-video-wrap { min-height: 55vh; }
}
.id-stage {
  padding: 8px;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
  min-height: 0;
  height: 100%;
}
.id-stage > .muted.small { margin: 0 !important; flex: none; }
.id-video-wrap {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  background: #000;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.id-zoom-stage {
  position: relative;
  width: 100%;
  height: 100%;
  transform-origin: center center;
  will-change: transform;
}
.id-video-wrap video {
  width: 100%;
  height: 100%;
  max-height: none;
  object-fit: contain;
  display: block;
  background: #000;
}
.id-video-wrap canvas {
  position: absolute;
  left: 0;
  top: 0;
  cursor: crosshair;
  pointer-events: auto;
}
.id-video-wrap.is-panning canvas { cursor: grabbing; }
.id-controls { margin: 0; gap: 8px; flex: none; flex-wrap: wrap; }
.id-zoom-ctrl { margin: 0; display: flex; gap: 6px; align-items: center; }
.id-zoom-ctrl input[type=range] { width: 110px; padding: 0; }
.id-time { font: 600 22px/1 ui-monospace, Menlo, monospace; min-width: 4.5em; }
.id-side {
  display: flex; flex-direction: column; gap: 10px;
  min-width: 0; min-height: 0; height: 100%; overflow: hidden;
}
.id-side > .card { margin-bottom: 0; flex: none; min-height: 0; }
.id-side > details.card { overflow: auto; max-height: 36%; }
.id-roster { display: flex; flex-direction: column; gap: 4px; max-height: min(28vh, 280px); overflow: auto; }
.id-name { text-align: left; width: 100%; padding: 7px 10px; border: 1px solid var(--line); background: var(--card); border-radius: 6px; display: flex; justify-content: space-between; gap: 8px; }
.id-name:hover { border-color: var(--brand); }
.id-name.on { background: var(--brand-soft); border-color: var(--brand); font-weight: 600; }
.id-asg-card {
  flex: 1 1 auto !important;
  display: flex; flex-direction: column; gap: 8px;
  min-height: 0; overflow: hidden;
}
.id-asg-head { flex: none; margin-bottom: 0; }
.id-asg-card #id-break-hint { flex: none; margin: 0; }
.id-asg-list { flex: 1 1 auto; min-height: 0; overflow: auto; }
.id-asg-row { padding: 6px 0; border-bottom: 1px solid var(--line); }
.id-asg-row:last-child { border-bottom: none; }
.id-ctx {
  position: fixed; z-index: 40; min-width: 220px; max-width: min(320px, 92vw);
  max-height: min(70vh, 480px); overflow: hidden; display: flex; flex-direction: column;
  background: var(--card); border: 1px solid var(--line); border-radius: 8px;
  box-shadow: 0 10px 28px rgba(0,0,0,.18); padding: 8px;
}
.id-ctx[hidden] { display: none !important; }
.id-ctx-head { font-size: 12px; color: var(--muted); margin: 0 0 6px; padding: 0 2px; }
.id-ctx-filter { margin-bottom: 6px; }
.id-ctx-list { overflow: auto; display: flex; flex-direction: column; gap: 3px; flex: 1; min-height: 0; }
.id-ctx-list .id-name { padding: 6px 8px; font-size: 13px; }
.id-ctx-foot { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line); display: flex; gap: 8px; flex-wrap: wrap; }

/* numbered game-page sections and grouped run stages */
.sec-num { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--brand); color: #fff; font-size: 13px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
.sec-order { margin: 0 4px 8px; }
.sec-title { min-width: 120px; }
.run-group { border-top: 1px solid var(--line); margin-top: 16px; padding-top: 10px; }
.run-group:first-child { border-top: 0; margin-top: 8px; padding-top: 0; }
.run-group-h { font-size: 14px; }
.run-group .run-steps { margin-top: 6px; }

/* small "i" with a hover / focus pop-up (Run stages) */
.info-i { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 17px; height: 17px; margin-left: 4px; border-radius: 50%; border: 1px solid var(--muted); color: var(--muted); font: italic 700 11px/1 Georgia, serif; cursor: help; vertical-align: middle; flex: none; }
.info-i:hover, .info-i:focus { color: var(--brand); border-color: var(--brand); outline: none; }
.info-i:hover::after, .info-i:focus::after { content: attr(data-tip); position: absolute; left: -8px; top: 24px; z-index: 50; width: 340px; max-width: 80vw; padding: 9px 12px; border-radius: 8px; background: #1d2b22; color: #eef4f0; font: 400 13px/1.4 system-ui, sans-serif; font-style: normal; white-space: normal; text-align: left; box-shadow: 0 6px 18px rgba(0,0,0,.28); pointer-events: none; }
.run-step { align-items: center; }

/* Run / Stop / Full window on the Run section header */
.sec-btns { display: flex; gap: 8px; flex: none; margin-left: auto; }
.sec-btns button { padding: 5px 12px; font-size: 13px; }
.run-view:not(.max) #run-stop2, .run-view:not(.max) #run-max-close { display: none; }

/* Track Players side panel: foldable cards, positions grid */
.id-fold > summary { list-style: none; cursor: pointer; display: flex; align-items: baseline; gap: 8px; }
.id-fold > summary::-webkit-details-marker { display: none; }
.id-fold > summary::before { content: "\25B8"; color: var(--muted); transition: transform .15s; }
.id-fold[open] > summary::before { transform: rotate(90deg); }
.id-roles-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1fr); gap: 6px; align-items: center; margin-bottom: 4px; }
.id-roles-grid select { width: 100%; padding: 4px 6px; font-size: 12px; }
.id-roles-head > span:first-child { font-weight: 600; }
#id-build { background: var(--brand); color: var(--brand-ink); border: 1px solid var(--brand); font-weight: 600; }
#id-build:hover:not(:disabled) { filter: brightness(1.08); }
#id-build:disabled { opacity: .5; cursor: not-allowed; }

/* accordion in the Track Players side panel: the open card takes the spare height and scrolls */
.id-side > details.id-acc { max-height: none; overflow: hidden; flex: 0 0 auto; }
.id-side > details.id-acc[open] { flex: 1 1 0; min-height: 0; overflow: auto; }
.id-acc > summary { position: sticky; top: 0; background: var(--card); z-index: 1; padding-bottom: 4px; }
.id-acc .id-asg-list { overflow: visible; }

.id-badge { border: 0; cursor: pointer; margin: 3px 0 0; font-family: inherit; }
.id-segs { margin: 4px 0 2px; padding-left: 8px; border-left: 2px solid var(--line); }
.id-seg { padding: 1px 0; }
#id-prev-break, #id-next-break { padding: 8px 10px; font-size: 12px; line-height: 1.4; }
.badge-n { display: inline-block; min-width: 18px; padding: 0 6px; margin-left: 4px; border-radius: 99px; background: rgba(255,255,255,.28); font-size: 11px; font-weight: 700; line-height: 17px; text-align: center; }
#id-prev-break .badge-n { background: var(--line); color: var(--text); }
#id-reset { color: var(--bad); border: 1px solid var(--bad); background: transparent; }
#id-reset:hover:not(:disabled) { background: var(--bad-soft); }
#id-reset:disabled { opacity: .5; cursor: not-allowed; }
